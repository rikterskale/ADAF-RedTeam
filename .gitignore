# Evidence / run output — never commit engagement output.
out/
*.egg-info/
__pycache__/
.pytest_cache/
.ruff_cache/
build/
dist/
.venv/
venv/
review-output/
certification-evidence/
certification-work/

# Local certification settings can contain credentials.  The two supported
# platform-specific files must remain local to the operator workstation.
.env.lab
.env.lab.ps1

# Never commit real (operator-created) engagement files or results, anywhere.
engagement*.json
validation-result.json
validation-linkage.json
transaction-journal*.jsonl
manifest.json

# ...but the committed example and schema files are NOT secrets — keep tracked.
# (These negations must follow the ignores above.)
!examples/engagement.example.json
!schemas/*.schema.json
